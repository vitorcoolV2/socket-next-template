version: 1
metadata:
  name: Home2500 fotos apply OIDC
  slug: blueprint-home2500-fotos-apply-oidc
  labels:
    Domain: "fotos.home2500.local"
entries:
  - model: authentik_providers_oauth2.oauth2provider
    id: prov-fotos-oidc
    identifiers:
      name: "fotos-provider"
    attrs:
      client_type: "confidential"
      client_id: "immich-fdgds53c"
      client_secret: "Y2yme4oPNzWbNE7RxJmKbwStNdYFuv4DyfyvdtLT5cemeffss"
      
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]

      redirect_uris: 
        - { "url": "https://fotos.home2500.local/auth/login", "matching_mode": "strict" }
        - { "url": "https://fotos.home2500.local/user-settings", "matching_mode": "strict" }
        - { "url": "https://fotos.home2500.local/", "matching_mode": "strict" }
      
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, "authentik Self-signed Certificate"]]
          

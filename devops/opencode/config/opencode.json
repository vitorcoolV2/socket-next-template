{
    "$schema": "https://opencode.ai/config.json",
    "model": "ollama/MFDoom/deepseek-coder-v2-tool-calling:latest",
    "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "ask",
        "write": "ask",
        "list": "allow",
        "skill": "allow",
        "webfetch": "ask"
    },
    "provider": {
        "ollama": {
            "name": "Local Ollama",
            "npm": "@ai-sdk/openai-compatible",
            "models": {
                "MFDoom/deepseek-coder-v2-tool-calling:latest": {
                    "name": "DeepSeek V2 (Architect/Explorer)",
                    "tool": true,
                    "options": {
                        "num_ctx": 32768,
                        "temperature": 0.2
                    }
                },
                "qwen2.5-coder:14b-instruct": {
                    "name": "Qwen 14B (Security/Auth/Network)",
                    "tool": true,
                    "options": {
                        "num_ctx": 32768,
                        "temperature": 0.4
                    }
                },
                "qwen2.5-coder:1.5b": {
                    "name": "Qwen 1.5B (Fast Fixer)",
                    "tool": true,
                    "options": {
                        "num_ctx": 8192,
                        "temperature": 0.1,
                        "num_predict": 512
                    }
                },
                "llama3.2:1b": {
                    "name": "Llama 3.2 (Chat/Docs)",
                    "tool": true,
                    "options": {
                        "num_ctx": 4096,
                        "temperature": 0.7
                    }
                }
            },
            "options": {
                "baseURL": "http://ai.app-network:11434/v1",
                "allowUnsafeTools": true,
                "shell": "/bin/bash"
            }
        }
    },
    "disabled_providers": [],
    "instructions": [
        "devops/opencode/AGENTS.md",
        "config/skills/**/*.md"
    ],
    "autoupdate": true,
    "default_agent": "plan"
}